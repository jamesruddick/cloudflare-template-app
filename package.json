{
  "name": "cloudflare-template-app",
  "version": "0.0.0",
  "private": true,
  "description": "A full-stack starter running entirely on Cloudflare Workers, with Hono for the API and React for the UI.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wrangler types && pnpm --filter frontend build && vite build",
    "deploy": "pnpm build && pnpm run deploy:worker",
    "deploy:worker": "wrangler deploy -c dist/cloudflare_template_app/wrangler.json",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit -p tsconfig.json && pnpm --filter frontend typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "hono": "^4.13.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.143.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.6.0"
}

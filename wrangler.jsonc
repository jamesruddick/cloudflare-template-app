{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-template-app",
  "main": "src/index.ts",
  // Capped by the OLDEST workerd in the toolchain, which is not wrangler's. The test suite runs inside
  // the binary `@cloudflare/vitest-pool-workers` bundles, while wrangler ships a newer one - so a date
  // past what the pool supports builds and deploys fine and then fails every test file with
  // ERR_RUNTIME_FAILURE. Raise it when the pool catches up.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API reaches the Worker; everything else goes to the asset handler, which serves the SPA
    // shell for unmatched paths. Broadening this to "/*" routes documents through Hono too, and since
    // there is no document handler here they all 404 - deep links and the entry page alike.
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["API_KEY", "JWT_SECRET"]
  }
}

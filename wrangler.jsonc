{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-template-app",
  "main": "src/index.ts",
  // Capped by the oldest workerd in the toolchain - the one miniflare carries, pinned by
  // @cloudflare/vitest-plugin. A later date deploys fine but fails every test with ERR_RUNTIME_FAILURE.
  // Check with `pnpm test`; `pnpm why workerd -r` should list one version.
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API reaches the Worker; everything else goes to the asset handler, which serves the SPA
    // shell for unmatched paths. Broadening this to "/*" routes documents through Hono too, and since
    // there is no document handler here they all 404 - deep links and the entry page alike.
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["API_KEY", "JWT_SECRET"]
  }
}
